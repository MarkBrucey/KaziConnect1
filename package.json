{
  "name": "kazi-connect-api",
  "version": "1.3.0",
  "description": "Kazi Connect API: job listings and requests for Ujuzi, plus accounts, employer tools and event work (staffing roles from Sherehe) for the Kazi Connect website, verified against openapi.yaml",
  "main": "server.ts",
  "scripts": {
    "dev": "tsx watch server.ts --dev",
    "build": "next build",
    "start": "tsx server.ts",
    "typecheck": "tsc --noEmit",
    "types": "openapi-typescript openapi.yaml -o types/api.d.ts && openapi-typescript partner-tests/sherehe_openapi.yaml -o types/sherehe.d.ts",
    "test": "next build && jest --runInBand",
    "verify": "tsx scripts/verifyContract.ts",
    "test:partner": "jest --testMatch \"**/partner-tests/*.partner.js\" --verbose",
    "ring:status": "tsx scripts/ringStatus.ts"
  },
  "dependencies": {
    "next": "^16.4.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "swagger-ui-react": "^5.34.0",
    "tsx": "^4.23.15",
    "ws": "^8.22.0",
    "yaml": "^2.9.1"
  },
  "private": true,
  "engines": {
    "node": ">=20.9"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-react": "^5.18.0",
    "@types/ws": "^8.18.2",
    "jest": "^30.5.2",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.31",
    "supertest": "^7.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
