{
  "name": "kazi-connect-api",
  "version": "1.3.0",
  "description": "Kazi Connect API: job listings and requests for Ujuzi, plus accounts, employer tools and event work (staffing roles from Sherehe) for the Kazi Connect website, verified against openapi.yaml",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "verify": "node verifyContract.js",
    "test": "jest --runInBand",
    "test:partner": "jest --testMatch \"**/partner-tests/*.partner.js\" --verbose"
  },
  "dependencies": {
    "express": "^5.2.1",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.22.0",
    "yaml": "^2.9.1"
  },
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.0"
  }
}
