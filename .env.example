# Copy to .env for local runs. Real values live in Render's settings, never in git.
PORT=3000
# PostgreSQL. Leave empty to use the in-memory store (tests, clean clones).
DATABASE_URL=
# Our upstream: Sherehe
SHEREHE_API_URL=https://sherehe-TODO.onrender.com
SHEREHE_API_KEY=
# Password reset emails (optional; without them links are printed in the terminal)
BREVO_API_KEY=
MAIL_FROM=
APP_URL=
# How often the server checks Sherehe for decisions on pending staffing offers (milliseconds, minimum 5000)
# OFFER_POLL_MS=180000
