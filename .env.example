# Copy to .env for local runs. Real values live in Render's settings, never in git.
PORT=3000
# PostgreSQL. Leave empty to use the in-memory store (tests, clean clones).
DATABASE_URL=
# Our upstream: Sherehe
SHEREHE_API_URL=https://sherehe-TODO.onrender.com
SHEREHE_API_KEY=
# Who may call us (Week 9). One key per consumer, as name:key, comma separated. Make a key with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Leave API_KEYS empty to run open (your own computer, the tests). Setting it turns on the key check AND the rate limit.
# The consumer named "website" is the key our own pages send: every visitor can see it, so it protects nothing by itself.
# Example (placeholders, not real keys):  API_KEYS=ujuzi:<a-long-random-key>,website:<another>,team:<another>
API_KEYS=
# true = refuse every call until a valid key is configured (so a deployment that forgot API_KEYS is closed, not open)
# REQUIRE_API_KEY=true
# Calls allowed per consumer per window (default 100 per 60000 ms; 0 turns the limit off), and wrong keys per address (default 20)
# API_RATE_LIMIT=100
# API_RATE_WINDOW_MS=60000
# API_FAILED_KEY_LIMIT=20
# Password reset emails (optional; without them links are printed in the terminal on your own computer, and not printed once API_KEYS is set)
BREVO_API_KEY=
MAIL_FROM=
APP_URL=
# How often the server checks Sherehe for decisions on pending staffing offers (milliseconds, minimum 5000)
# OFFER_POLL_MS=180000
# Used by npm run ring:status, which checks how far each system in the ring has got.
# Kazi's own live address, and Ujuzi's (the TODO means it has not been shared yet). Sherehe's is SHEREHE_API_URL above.
KAZI_URL=https://kaziconnect1-1xmu.onrender.com
UJUZI_URL=https://ujuzi-TODO.onrender.com
# Only for npm run ring:status and ring:check: the key to send to KAZI_URL once Kazi Connect asks for one.
# KAZI_API_KEY=
